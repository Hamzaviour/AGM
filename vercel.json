{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "cleanUrls": false,
  "redirects": [
    { "source": "/", "destination": "/simulation/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/simulation/vendor/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
